# SwiftBox Kiosk Terminal - Environment Configuration
# Firebase Realtime Database Client Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Target SwiftBox Backend URL (for future API mediation)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Kiosk Device Authentication Credentials
EXPO_PUBLIC_KIOSK_ID=KIOSK_PCC_01
EXPO_PUBLIC_KIOSK_TOKEN=your_secure_kiosk_device_secret_here
